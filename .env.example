# Copy to .env and adjust as needed. Load with: node --env-file=.env src/server.js

PORT=3000

# Cache-aside TTL for /api/products (milliseconds)
CACHE_TTL_MS=30000

# Rate limiting applied to every /api route
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Max time to wait for in-flight background jobs during shutdown (milliseconds)
SHUTDOWN_TIMEOUT_MS=10000
